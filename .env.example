# Tile CDN base URL (no trailing slash).
# Leave unset during local dev to serve from public/tiles/.
# For production, use the bucket's public URL, not the R2 S3 API endpoint.
# Good:
#   NEXT_PUBLIC_TILE_BASE=https://pub-xxxxxxxxxxxxxxxx.r2.dev
#   NEXT_PUBLIC_TILE_BASE=https://tiles.example.com
# Bad:
#   NEXT_PUBLIC_TILE_BASE=https://<account-id>.r2.cloudflarestorage.com/<bucket>
NEXT_PUBLIC_TILE_BASE=
